# Vasooli Configuration

# Application
APP_NAME=Vasooli
DEBUG=True
DATABASE_URL=sqlite:///./vasooli.db

# AI Provider (mock, gemini, claude)
AI_PROVIDER=mock

# Optional: Gemini API Key (only if using AI_PROVIDER=gemini)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Claude API Key (only if using AI_PROVIDER=claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Razorpay Test Mode (Optional: Falls back to customer simulator if not provided)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Simulator seed for reproducibility
SIMULATOR_SEED=42

# Policy thresholds
MAX_CONTACT_ATTEMPTS=5
COOLDOWN_AFTER_PROMISE_DAYS=7
CONTACT_FREQUENCY_PER_DAY=2
PROMISE_CONFIDENCE_THRESHOLD=0.6
